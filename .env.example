# Copy to .env.local for local development. Never commit real secrets.
# PostgreSQL connection string from your managed provider (Neon is supported).
SAMURA_DATABASE_URL=
# Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Canonical app URL, e.g. http://localhost:3000 during local development.
BETTER_AUTH_URL=http://localhost:3000

# Default: local Ollama; no paid OpenAI API key required for local inference.
# Install Ollama and pull the selected model before testing chat locally.
SAMURA_AI_PROVIDER=ollama
SAMURA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
SAMURA_OLLAMA_MODEL=qwen3:8b

# Optional hosted provider with a limited free tier (availability/quotas can change).
# Set SAMURA_AI_PROVIDER=gemini and keep the key server-side.
# Review Google's free-tier data-use terms before sending confidential user content.
GEMINI_API_KEY=
SAMURA_GEMINI_MODEL=gemini-3.8-flash

# Optional paid provider; only used when SAMURA_AI_PROVIDER=openai.
# Keep server-side. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
SAMURA_OPENAI_MODEL=gpt-4.1-mini

SAMURA_MAX_REQUESTS_PER_MINUTE=20
SAMURA_MAX_INPUT_CHARS=12000
SAMURA_MAX_OUTPUT_TOKENS=1200
