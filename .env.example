# Copy to .env.local for local development. Never commit real secrets.
# PostgreSQL connection string from your managed provider (Neon is supported).
SAMURA_DATABASE_URL=
# Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Canonical app URL, e.g. http://localhost:3000 during local development.
BETTER_AUTH_URL=http://localhost:3000
# Server-only provider key. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Confirm the model is enabled for your provider account.
SAMURA_OPENAI_MODEL=gpt-4.1-mini
SAMURA_MAX_REQUESTS_PER_MINUTE=20
SAMURA_MAX_INPUT_CHARS=12000
SAMURA_MAX_OUTPUT_TOKENS=1200
