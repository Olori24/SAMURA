# Copy to .env.local for local development. Never commit real secrets.
SAMURA_DATABASE_URL=
# Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional authentication email. Use a sender on a verified SAMURA-owned domain.
RESEND_API_KEY=
SAMURA_EMAIL_FROM=

# Local development only unless you host Ollama at a reachable secured endpoint.
SAMURA_AI_PROVIDER=ollama
SAMURA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
SAMURA_OLLAMA_MODEL=qwen3:8b

# Alternative hosted provider: OpenRouter (OpenAI-compatible API).
# Create a key at https://openrouter.ai/keys; keep it server-side.
# For hosted deployments set SAMURA_AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
SAMURA_OPENROUTER_MODEL=openrouter/free

# Optional Gemini provider.
GEMINI_API_KEY=
SAMURA_GEMINI_MODEL=gemini-3.8-flash
# Optional image generation uses the same Gemini key; image-model usage may be billed.
SAMURA_GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Optional OpenAI-compatible image provider (Gemini is used when this is unset and its key is present).
SAMURA_IMAGE_API_KEY=
SAMURA_IMAGE_BASE_URL=
SAMURA_IMAGE_MODEL=gpt-image-1

# Optional Tavily web search. Alternatively, explicitly opt in to Gemini Search grounding below.
SAMURA_WEB_SEARCH_API_KEY=
# Gemini Search can incur per-query charges. Keep false until an administrator approves usage.
SAMURA_GEMINI_GROUNDING_ENABLED=false

# Optional OpenAI provider.
OPENAI_API_KEY=
SAMURA_OPENAI_MODEL=gpt-4.1-mini

SAMURA_MAX_REQUESTS_PER_MINUTE=20
SAMURA_MAX_INPUT_CHARS=12000
SAMURA_MAX_OUTPUT_TOKENS=1200
